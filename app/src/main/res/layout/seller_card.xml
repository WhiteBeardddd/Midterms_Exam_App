<?xml version="1.0" encoding="utf-8"?>
<!--
    Wrap the CardView in a FrameLayout so the avatar can float
    on top without being clipped by the CardView boundary.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="18dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The card itself — avatar is NOT inside here anymore -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_elevated"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Banner image + Open badge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="190dp">

                <ImageView
                    android:id="@+id/seller_bgimg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:background="@drawable/icon_button_bg"
                    android:clipToOutline="true"
                    android:src="@drawable/tarabytes"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/seller_isopen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/surface_card_soft"
                    android:fontFamily="@font/lexend_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Open"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

            </FrameLayout>

            <!-- Reserve space (37dp = half avatar height) so text isn't hidden behind avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/seller_shopname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lexend_bold"
                    android:maxLines="1"
                    android:text="Glow Beauty Studio"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/seller_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/lexend_regular"
                    android:maxLines="1"
                    android:text="Cebu City, Philippines"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/seller_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/lexend_regular"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="Affordable beauty essentials and skincare products for your daily glow."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/seller_pfp_card"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="167dp"
        app:cardCornerRadius="37dp"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/seller_pfpimg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/tarabytes"
            tools:ignore="ContentDescription" />

    </androidx.cardview.widget.CardView>

</FrameLayout>