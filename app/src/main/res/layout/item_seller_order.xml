<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/surface_card"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvBuyerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lexend_bold"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            tools:text="Princess" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_medium"
            android:textSize="10sp"
            android:textColor="@color/white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            tools:text="PENDING"
            tools:background="@color/gray_secondary" />

    </LinearLayout>

    <!-- Order date -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/lexend_regular"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        tools:text="May 09, 2026  08:49 PM" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#1FFFFFFF" />

    <!-- Section: Order Items -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_medium"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textColor="@color/text_muted"
        android:paddingBottom="6dp"
        android:text="Order Items" />

    <!-- Items are injected here -->
    <LinearLayout
        android:id="@+id/itemsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1FFFFFFF" />

    <!-- Total row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lexend_medium"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:text="Order Total" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_bold"
            android:textSize="14sp"
            android:textColor="@color/color_primary"
            tools:text="₱783.97" />

    </LinearLayout>

    <!-- Divider (conditionally visible) -->
    <View
        android:id="@+id/dividerAddress"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#1FFFFFFF"
        android:visibility="gone" />

    <!-- Section: Delivery Address (conditionally visible) -->
    <TextView
        android:id="@+id/labelAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_medium"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:textColor="@color/text_muted"
        android:paddingBottom="6dp"
        android:text="Delivery Address"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lexend_regular"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        tools:text="Bankal, Mahayahay&#10;Lapu-Lapu City 7777&#10;Ph" />

</LinearLayout>