<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_dark_bg"
    tools:context=".views.user.UserProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/layout_top_brand_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/surface_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_semibold"
                        android:text="Username"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_surface"
                        android:hint="Full Name"
                        android:padding="14dp"
                        android:textColor="@color/color_gray"
                        android:textColorHint="@color/text_muted"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/lexend_semibold"
                        android:text="Phone Number"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_surface"
                        android:hint="Phone Number"
                        android:inputType="phone"
                        android:padding="14dp"
                        android:textColor="@color/color_gray"
                        android:textColorHint="@color/text_muted"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/surface_card"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageButton
                        android:id="@+id/order_btn"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:background="@drawable/icon_button_bg"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/wallet_icon"
                        app:tint="@color/color_primary"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/address_btn"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/icon_button_bg"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/location_icon"
                        app:tint="@color/color_accent_teal"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/settings_btn"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/icon_button_bg"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/settings_gear"
                        app:tint="@color/color_gray"
                        tools:ignore="ContentDescription" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/surface_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSellerLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lexend_semibold"
                            android:text="Seller Mode"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/lexend_regular"
                            android:text="Enable this if you want to manage a store."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchIsSeller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutStoreName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/surface_card"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_semibold"
                        android:text="Store Name"
                        android:textColor="@color/color_accent_orange"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/etStoreName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/input_surface"
                        android:hint="e.g. TaraBytes Burger Joint"
                        android:padding="14dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/surface_card"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend_semibold"
                        android:padding="18dp"
                        android:text="General"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:id="@+id/headerSupport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Help Center"
                            android:textColor="@color/white"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/arrowSupport"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/down_chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contentSupport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include layout="@layout/dropdown_support"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/headerTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Terms &amp; policies"
                            android:textColor="@color/white"
                            tools:ignore="HardcodedText" />

                        <ImageView
                            android:id="@+id/arrowTerms"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/down_chevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/contentTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include layout="@layout/dropdown_terms"/>
                    </LinearLayout>
                </LinearLayout>



                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/hero_gradient_card"
                    app:backgroundTint="@null"
                    android:padding="10dp"
                    android:text="Save Profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/hero_gradient_card"
                    app:backgroundTint="@null"
                    android:padding="10dp"
                    android:text="Log Out"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/navigation_bar"
            layout="@layout/layout_navbar" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>